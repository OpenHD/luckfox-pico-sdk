#!/bin/sh
#
# sshd        Starts sshd.
#

# Make sure the ssh-keygen progam exists
[ -f /usr/bin/ssh-keygen ] || exit 0

umask 077

start() {
	mkdir -p /var/empty /var/lock /run/sshd /etc/ssh || return 1
	chown root:root /var/empty/ || return 1
	chmod 755 /var/empty /run/sshd || return 1
	# Create any missing keys
	/usr/bin/ssh-keygen -A || return 1

	printf "Starting sshd: "
	/usr/sbin/sshd -t || return 1
	/usr/sbin/sshd || return 1
	touch /var/lock/sshd
	echo "OK"
}
stop() {
	printf "Stopping sshd: "
	killall sshd
	rm -f /var/lock/sshd
	echo "OK"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?

