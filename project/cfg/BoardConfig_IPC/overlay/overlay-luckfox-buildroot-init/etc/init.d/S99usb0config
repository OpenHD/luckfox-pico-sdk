#!/bin/sh
# Match the OpenHD USB maintenance network when the port is in gadget mode.
TARGET_IP="192.168.7.2"
USB_MODE_PATH="/proc/device-tree/usbdrd/usb@ffb00000/dr_mode"

usb0_config() {
    retries=0
    while [ "$retries" -lt 20 ]; do
        if ifconfig usb0 "$TARGET_IP" netmask 255.255.255.0 up 2>/dev/null; then
            return 0
        fi
        retries=$((retries + 1))
        sleep 1
    done
    echo "OpenHD USB network interface unavailable" >&2
    return 1
}

case "$1" in
    start)
        [ -r "$USB_MODE_PATH" ] || exit 0
        usb_mode=$(tr -d '\000' < "$USB_MODE_PATH")
        case "$usb_mode" in peripheral|otg) usb0_config & ;; esac
        ;;
    stop) ;;
    *) exit 1 ;;
esac
